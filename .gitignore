node_modules/
# Single-file bundles are built locally and released through npm run deploy.
ocean.html
ocean.min.html
# local screenshot captures written by server.mjs (/__shot) and test shots
shots/
# local tooling
.claude/
.cloudflare/
.cloudflare-test/
.wrangler/
# Meshy credentials references, task records and generated source assets stay local.
.meshy/
# Tripo generations and the script that fits a rigged body to our skeleton, kept until they ship.
.tripo/
# Local sound-generation takes and request records.
.audio/
# Local authoring credentials; never commit or deploy these files.
.env
.env.*
!.env.example
# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
__pycache__/
# Large raw offline meadow source binaries (the meadows-gpu/ manifests are tracked)
assets/ground-cover/portugal/meadows/
# The people continuum's baked streams: npm run deploy publishes them, scripts/prepare-crew-continuum.mjs bakes them.
assets/crew/continuum/*/*
!assets/crew/continuum/*/manifest.json
docs/assets/crew/continuum/
# The ships' continuum is committed whole (no ship draws without it); the build's published copies are not.
docs/assets/ships/
assets/ground-cover/tropical/meadows/
# Saba's and Portugal's forest continuum atlases (and Portugal's offline raw vertex/index streams)
# are past GitHub's 100 MB a file: npm run deploy chunks and publishes them, while scripts/bake-forest-mature-pack.py
# and scripts/prepare-forest-continuum.mjs bake them (manifests with SHA-256 digests stay tracked).
assets/forest-scenery/saba/continuum/atlas.bin.gz
docs/assets/forest-scenery/saba/continuum/atlas.bin.*gz
assets/forest-scenery/portugal/continuum/atlas.bin.gz
docs/assets/forest-scenery/portugal/continuum/atlas.bin.*gz
assets/forest-scenery/portugal/vertices.bin.gz
assets/forest-scenery/portugal/indices.bin.gz
# The meadow continuum's atlases are past GitHub's 100 MB a file: npm run deploy publishes them,
# scripts/prepare-meadow-grass.mjs bakes them (their manifests, with each atlas's digest, are tracked).
assets/ground-cover/*/meadows-gpu/atlas.bin.gz
docs/assets/ground-cover/*/meadows-gpu/atlas.bin.*gz
