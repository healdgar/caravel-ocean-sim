node_modules/
# Single-file bundles are built locally and released through npm run deploy.
ocean.html
ocean.min.html
# local screenshot captures written by server.mjs (/__shot) and test shots
shots/
# local tooling
.claude/
.cloudflare/
.wrangler/
# Meshy credentials references, task records and generated source assets stay local.
.meshy/
# Tripo generations and the script that fits a rigged body to our skeleton, kept until they ship.
.tripo/
# Local sound-generation takes and request records.
.audio/
# Local authoring credentials; never commit or deploy these files.
.env
.env.*
!.env.example
# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
# Intermediate Hunyuan3D-2mv GLB and turnaround slice PNGs (final WW3D bundle is tracked)
assets/ports/1550/*.glb
assets/ports/1550/*.png
!assets/ports/1550/land-materials-pbr.png
assets/ports/1550/*/*.png
# Large raw offline meadow source binaries (compact meadows-gpu/ pack is tracked)
assets/ground-cover/portugal/meadows/
# The people continuum's baked streams: npm run deploy publishes them, scripts/prepare-crew-continuum.mjs bakes them.
assets/crew/continuum/*/*
!assets/crew/continuum/*/manifest.json
docs/assets/crew/continuum/
# The ships' continuum is committed whole (no ship draws without it); the build's published copies are not.
docs/assets/ships/
# The historical ports' baked prefab bodies: npm run deploy publishes them, scripts/prepare-prefab-continuum.mjs bakes them.
assets/prefab-continuum/*.bin.gz
docs/assets/prefab-continuum/
